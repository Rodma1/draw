<mxfile host="app.diagrams.net" agent="Hermes" version="29.2.7" type="device"><diagram id="p1" name="配图1-流式vs非流式"><mxGraphModel dx="1426" dy="743" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="hd_t" value="流式 vs 非流式" style="text;html=1;fontSize=22;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="22" width="810" height="34" as="geometry"/></mxCell><mxCell id="hd_s" value="非流式攒齐整段再给，流式来一个 token 给一个" style="text;html=1;fontSize=13;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="58" width="810" height="22" as="geometry"/></mxCell><mxCell id="hd_l" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e5e7eb;strokeColor=#e5e7eb;" vertex="1" parent="1"><mxGeometry x="45" y="92" width="810" height="2" as="geometry"/></mxCell><mxCell id="lt" value="非流式  run()" style="text;html=1;fontSize=16;fontColor=#6B7280;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="300" height="30" as="geometry"/></mxCell><mxCell id="rt" value="流式  run_streamed()" style="text;html=1;fontSize=16;fontColor=#007EA8;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="130" width="300" height="30" as="geometry"/></mxCell><mxCell id="l1" value="&lt;b style=&quot;font-size:14px&quot;&gt;模型生成整段回答&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#6B7280&quot;&gt;所有 token 都攒着&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#d1d5db;fontSize=12;fontStyle=0;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="340" height="64" as="geometry"/></mxCell><mxCell id="l2" value="&lt;b style=&quot;font-size:14px&quot;&gt;一次性返回&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;