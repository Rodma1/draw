  <diagram id="pg1" name="配图1-时延的四个组成">
    <mxGraphModel grid="0" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1200" pageHeight="640" math="0" shadow="0">
