<mxfile host="app.diagrams.net" agent="Hermes" version="29.2.7" type="device"><diagram id="p1" name="配图1-四层零件图"><mxGraphModel dx="1426" dy="743" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="hd_t" value="四层零件，一层层往上叠" style="text;html=1;fontSize=22;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="22" width="1079" height="34" as="geometry"/></mxCell><mxCell id="hd_s" value="每一层先单独跑通，再往上叠；跑不通就别往下走" style="text;html=1;fontSize=13;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="58" width="1079" height="22" as="geometry"/></mxCell><mxCell id="hd_l" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e5e7eb;strokeColor=#e5e7eb;" vertex="1" parent="1"><mxGeometry x="45" y="92" width="1079" height="2" as="geometry"/></mxCell><mxCell id="goal" value="&lt;b style=&quot;font-size:17px;color:#ffffff&quot;&gt;目标：能回答自己知识库的问答服务&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#00BEF2;strokeColor=#007EA8;fontSize=16;fontStyle=1;align=center;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="180" y="140" width="800" height="74" as="geometry"/></mxCell><mxCell id="l4" value="&lt;b style=&quot;font-size:16px&quot;&gt;第 9-10 天　记忆层&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#6B7280&quot;&gt;处理指代、上下文膨胀、话题切换&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="180" y="250" width="800" height="80" as="geometry"/></mxCell><mxCell id="l3" value="&lt;b style=&quot;font-size:16px&quot;&gt;第 7-8 天　工具层&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#6B7280&quot;&gt;查实时数据、算数、调外部接口&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="180" y="355" width="800" height="80" as="geometry"/></mxCell><mxCell id="l2" value="&lt;b style=&quot;font-size:16px&quot;&gt;第 3-6 天　检索层&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#6B7280&quot;&gt;找到相关段落，让它知道自己不知道&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="180" y="460" width="800" height="80" as="geometry"/></mxCell><mxCell id="l1" value="&lt;b style=&quot;font-size:16px&quot;&gt;第 1-2 天　调用层&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#6B7280&quot;&gt;请求怎么拼、流怎么收、错怎么报&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;align=center;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="180" y="565" width="800" height="80" as="geometry"/></mxCell><mxCell id="note" value="&lt;font style=&quot;font-size:13px;color:#6B7280&quot;&gt;底层不通，上面每一层看起来都像有 bug&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=0;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="690" width="560" height="52" as="geometry"/></mxCell><mxCell id="wm" value="公众号:神的孩子都在歌唱" style="text;html=1;fontSize=18;fontColor=#9CA3AF;opacity=40;align=right;verticalAlign=middle;opacityGroup=1;textOpacity=70;" vertex="1" parent="1"><mxGeometry x="968" y="781" width="179" height="34" as="geometry"/></mxCell><mxCell id="wm_mid" value="公众号:神的孩子都在歌唱" style="text;html=1;fontSize=18;fontColor=#9CA3AF;opacity=40;align=right;verticalAlign=middle;opacityGroup=1;textOpacity=30;rotation=-15;" vertex="1" parent="1"><mxGeometry x="445" y="439" width="179" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>