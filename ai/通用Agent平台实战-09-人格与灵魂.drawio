<mxfile host="app.diagrams.net" agent="Hermes" version="29.2.7" type="device"><diagram id="p1" name="配图1-人设五维度"><mxGraphModel dx="1426" dy="743" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="hd_t" value="人设的五个维度" style="text;html=1;fontSize=22;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="22" width="810" height="34" as="geometry"/></mxCell><mxCell id="hd_s" value="照着这五条写，Agent 才能稳定地像个“人”" style="text;html=1;fontSize=13;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="58" width="810" height="22" as="geometry"/></mxCell><mxCell id="hd_l" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e5e7eb;strokeColor=#e5e7eb;" vertex="1" parent="1"><mxGeometry x="45" y="92" width="810" height="2" as="geometry"/></mxCell><mxCell id="d角" value="&lt;b style=&quot;font-size:15px&quot;&gt;角色　它是谁&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#6B7280&quot;&gt;干了 15 年的资深架构师，越具体越好演&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=0;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="780" height="66" as="geometry"/></mxCell><mxCell id="d性" value="&lt;b style=&quot;font-size:15px&quot;&gt;性格　什么脾气&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#6B7280&quot;&gt;直白、务实、不装，写能指导行为的&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=0;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="238" width="780" height="66" as="geometry"/></mxCell><mxCell id="d语" value="&lt;b style=&quot;font-size:15px&quot;&gt;语气　怎么说话&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#6B7280&quot;&gt;先结论、打比方、偶尔吐槽&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=0;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="326" width="780" height="66" as="geometry"/></mxCell><mxCell id="d边" value="&lt;b style=&quot;font-size:15px&quot;&gt;边界　什么不干&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#6B7280&quot;&gt;不确定就直说、无关话题别展开、绝不瞎编&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=0;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="414" width="780" height="66" as="geometry"/></mxCell><mxCell id="d习" value="&lt;b style=&quot;font-size:15px&quot;&gt;习惯　让人记住&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#6B7280&quot;&gt;回答不超过 3 句，固定的口头禅&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=0;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="502" width="780" height="66" as="geometry"/></mxCell><mxCell id="wm" value="公众号:神的孩子都在歌唱" style="text;html=1;fontSize=18;fontColor=#9CA3AF;opacity=40;align=right;verticalAlign=middle;opacityGroup=1;textOpacity=70;" vertex="1" parent="1"><mxGeometry x="699" y="594" width="179" height="34" as="geometry"/></mxCell><mxCell id="wm_mid" value="公众号:神的孩子都在歌唱" style="text;html=1;fontSize=18;fontColor=#9CA3AF;opacity=40;align=right;verticalAlign=middle;opacityGroup=1;textOpacity=30;rotation=-15;" vertex="1" parent="1"><mxGeometry x="342" y="339" width="179" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>