<mxfile host="app.diagrams.net" agent="Hermes" version="29.2.7" type="device"><diagram id="p1" name="配图1-完整链路"><mxGraphModel dx="1426" dy="743" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="hd_t" value="一次问答的完整链路" style="text;html=1;fontSize=22;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="22" width="1079" height="34" as="geometry"/></mxCell><mxCell id="hd_s" value="只有一次 HTTP 请求，剩下都是在读同一个响应流" style="text;html=1;fontSize=13;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="58" width="1079" height="22" as="geometry"/></mxCell><mxCell id="hd_l" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e5e7eb;strokeColor=#e5e7eb;" vertex="1" parent="1"><mxGeometry x="45" y="92" width="1079" height="2" as="geometry"/></mxCell><mxCell id="proc" value="&lt;b style=&quot;font-size:15px&quot;&gt;你的 chat.py 进程&lt;/b&gt;" style="swimlane;startSize=34;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=15;fontStyle=1;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="80" y="150" width="420" height="480" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b style=&quot;font-size:15px&quot;&gt;① 拼 messages + payload&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=0;align=center;" vertex="1" parent="proc"><mxGeometry x="30" y="50" width="360" height="76" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b style=&quot;font-size:15px&quot;&gt;③ 逐行读 data:&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=0;align=center;" vertex="1" parent="proc"><mxGeometry x="30" y="170" width="360" height="76" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b style=&quot;font-size:15px&quot;&gt;④ 拼 delta.content&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#6B7280&quot;&gt;打印到终端&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=0;align=center;" vertex="1" parent="proc"><mxGeometry x="30" y="290" width="360" height="90" as="geometry"/></mxCell><mxCell id="llm" value="&lt;b style=&quot;font-size:17px&quot;&gt;LLM 服务&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#6B7280&quot;&gt;/v1/chat/completions&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;fontStyle=1;align=center;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="720" y="300" width="340" height="110" as="geometry"/></mxCell><mxCell id="e1" value="POST JSON" style="endArrow=block;endSize=6;html=1;strokeWidth=2;strokeColor=#374151;fontSize=13;fontColor=#374151;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="200" as="sourcePoint"/><mxPoint x="718" y="320" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e2" value="SSE 流 data:" style="endArrow=block;endSize=6;html=1;strokeWidth=2;strokeColor=#d79b00;fontSize=13;fontColor=#d79b00;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="718" y="400" as="sourcePoint"/><mxPoint x="502" y="340" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e3" value="" style="endArrow=block;endSize=6;html=1;strokeWidth=2;strokeColor=#374151;fontSize=12;fontColor=#374151;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="410" as="sourcePoint"/><mxPoint x="290" y="462" as="targetPoint"/></mxGeometry></mxCell><mxCell id="note" value="&lt;font style=&quot;font-size:13px;color:#6B7280&quot;&gt;流式模式别调 resp.json()，会把整个流缓冲完，等于没开流式&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ff