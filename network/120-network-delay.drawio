<mxfile host="app.diagrams.net" agent="Hermes" version="29.2.7" type="device"><diagram id="pg1" name="配图1-时延的四个组成"><mxGraphModel dx="1426" dy="743" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="hd_t" value="一个数据包从 A 到 B，时间花在哪了" style="text;html=1;fontSize=22;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="22" width="1110" height="34" as="geometry"/></mxCell><mxCell id="hd_s" value="发送 → 传播 → 处理 → 排队，四段加起来才是总时延" style="text;html=1;fontSize=13;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="58" width="1110" height="22" as="geometry"/></mxCell><mxCell id="hd_l" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e5e7eb;strokeColor=#e5e7eb;" vertex="1" parent="1"><mxGeometry x="45" y="92" width="1110" height="2" as="geometry"/></mxCell><mxCell id="a" value="发送端 A" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontStyle=1;align=center;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="130" height="70" as="geometry"/></mxCell><mxCell id="b" value="接收端 B" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontStyle=1;align=center;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1010" y="150" width="130" height="70" as="geometry"/></mxCell><mxCell id="s0" value="① 发送时延" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="200" y="150" width="200" height="70" as="geometry"/></mxCell><mxCell id="d0" value="把比特推上链路
