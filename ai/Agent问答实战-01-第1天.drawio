etry"/></mxCell><mxCell id="note" value="&lt;font style=&quot;font-size:13px;color:#6B7280&quot;&gt;长回答场景，两者的体感差距是好几倍&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=0;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="650" width="560" height="56" as="geometry"/></mxCell><mxCell id="wm" value="公众号:神的孩子都在歌唱" style="text;html=1;fontSize=18;fontColor=#9CA3AF;opacity=40;align=right;verticalAlign=middle;opacityGroup=1;textOpacity=70;" vertex="1" parent="1"><mxGeometry x="968" y="781" width="179" height="34" as="geometry"/></mxCell><mxCell id="wm_mid" value="公众号:神的孩子都在歌唱" style="text;html=1;fontSize=18;fontColor=#9CA3AF;opacity=40;align=right;verticalAlign=middle;opacityGroup=1;textOpacity=30;rotation=-15;" vertex="1" parent="1"><mxGeometry x="445" y="439" width="179" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="配图4-出错定位"><mxGraphModel dx="1426" dy="743" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="hd_t" value="出错定位：现象 → 原因 → 修法" style="text;html=1;fontSize=22;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="22" width="1079" height="34" as="geometry"/></mxCell><mxCell id="hd_s" value="前四行看状态码，后两行看现象——乱码和卡住不报错，最难查" style="text;html=1;fontSize=13;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="58" width="1079" height="22" as="geometry"/></mxCell><mxCell id="hd_l" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e5e7eb;strokeColor=#e5e7eb;" vertex="1" parent="1"><mxGeometry x="45" y="92" width="1079" height="2" as="geometry"/></mxCell><mxCell id="h_60" value="&lt;b style=&quot;font-size:15px;color:#ffffff&quot;&gt;现象&lt;/b&gt;" style="rounded=1;arcSi