<mxfile host="app.diagrams.net" agent="Hermes" version="29.2.7" type="device"><diagram id="p1" name="配图1-context流向"><mxGraphModel dx="1426" dy="743" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="520" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="hd_t" value="context 的流向" style="text;html=1;fontSize=22;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="22" width="810" height="34" as="geometry"/></mxCell><mxCell id="hd_s" value="本地对象，只在工具/回调里流转，模型看不到" style="text;html=1;fontSize=13;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="58" width="810" height="22" as="geometry"/></mxCell><mxCell id="hd_l" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e5e7eb;strokeColor=#e5e7eb;" vertex="1" parent="1"><mxGeometry x="45" y="92" width="810" height="2" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b style=&quot;font-size:14px&quot;&gt;创建上下文对象&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#6B7280&quot;&gt;UserContext(name=&quot;张三&quot;, uid=&quot;u1001&quot;)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#d1d5db;fontSize=12;fontStyle=0;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="240" height="84" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b style=&quot;font-size:14px&quot;&gt;传给 Runner&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#6B7280&quot;&gt;Runner.run(..., context=user)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=0;align=center;" vertex="1" parent="1"><mxGeometry x="330" y="180" width="240" height="84" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b style=&quot;font-size:14px&quot;&gt;工具读写它&lt;/b&gt;&lt;br&gt;&lt;font style=&quot