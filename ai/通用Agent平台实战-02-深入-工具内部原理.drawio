<mxfile host="app.diagrams.net" agent="Hermes" version="29.2.7" type="device"><diagram id="p1" name="配图1-工具执行链路"><mxGraphModel dx="1426" dy="743" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="hd_t" value="工具执行的完整链路" style="text;html=1;fontSize=22;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="22" width="810" height="34" as="geometry"/></mxCell><mxCell id="hd_s" value="模型点菜，SDK 查表、调函数、喂结果" style="text;html=1;fontSize=13;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="58" width="810" height="22" as="geometry"/></mxCell><mxCell id="hd_l" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e5e7eb;strokeColor=#e5e7eb;" vertex="1" parent="1"><mxGeometry x="45" y="92" width="810" height="2" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b style=&quot;font-size:15px&quot;&gt;① SDK 发工具清单给模型&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#6B7280&quot;&gt;name + description + 参数 schema，当菜单&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#d1d5db;fontSize=12;fontStyle=0;align=center;" vertex="1" parent="1"><mxGeometry x="170" y="140" width="560" height="66" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b style=&quot;font-size:15px&quot;&gt;② 模型点菜&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#6B7280&quot;&gt;返回&quot;调 query_sales&quot;，参数 date=2026-11-25&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=0;align=center;" vertex="1" parent="1"><mxGeometry x="170" y="262" width="560" height="80" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b style=&quot;font-size:15px&quot;&gt;③ SDK 查表找工具&lt;/b&gt;&lt;br&gt;&lt;font style=&quot